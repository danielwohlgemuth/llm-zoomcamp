                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "megabase",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  COALESCE(input_tokens, 0) as \"input tokens\",\n  COALESCE(output_tokens, 0) as \"output tokens\"\nFROM\n  message\nWHERE\n  $__timeFilter(created_at) ",
                        "sql": {
