                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "megabase",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH per_conversation AS (\n  SELECT\n    c.id,\n    COUNT(m.id) as messages\n  FROM\n    conversation AS c\n    LEFT JOIN message AS m ON (c.id = m.conversation_id)\n  WHERE\n    $__timeFilter(m.created_at)\n  GROUP BY\n    1\n)\nSELECT\n  messages,\n  COUNT(*) AS conversations\nFROM\n  per_conversation\nGROUP BY\n  messages\nORDER BY\n  messages",
                        "sql": {
                          "columns": [
                            {
                              "name": "COUNT",
                              "parameters": [
                                {
                                  "name": "id",
                                  "type": "functionParameter"
                                }
                              ],
