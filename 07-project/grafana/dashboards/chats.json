                        "rawSql": "SELECT\n  SUM(\n    input_tokens * input_price_per_million_tokens / 1000000 + output_tokens * output_price_per_million_tokens / 1000000\n  ) AS \"Total\",\n  AVG(\n    input_tokens * input_price_per_million_tokens / 1000000 + output_tokens * output_price_per_million_tokens / 1000000\n  ) AS \"Average\",\n  MIN(\n    input_tokens * input_price_per_million_tokens / 1000000 + output_tokens * output_price_per_million_tokens / 1000000\n  ) AS \"Minimum\",\n  MAX(\n    input_tokens * input_price_per_million_tokens / 1000000 + output_tokens * output_price_per_million_tokens / 1000000\n  ) AS \"Maximum\"\nFROM\n  message\n  JOIN model AS m ON (m.name = model)\nWHERE\n  $__timeFilter(created_at)",
