{
    "name": "07-project",
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/07-project",
    "postCreateCommand": "cd ${containerWorkspaceFolder} && uv sync && git config --global --add safe.directory ${containerWorkspaceFolder}",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "anthropic.claude-code",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {},
        "ghcr.io/devcontainers-extra/features/uv": {}
    },
    "runArgs": ["--env-file", "07-project/.env"]
}