      "panel-8": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cg1ucqa2lj8qoc"
                      },
                      "group": "datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "megabase",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH numbered AS (\n  SELECT\n    row_number() OVER (PARTITION BY m.conversation_id ORDER BY m.created_at) AS turn,\n    m.input_tokens\n  FROM message AS m\n  JOIN conversation AS c ON c.id = m.conversation_id\n  WHERE m.status = 'Completed'\n    AND $__timeFilter(c.created_at) \n)\nSELECT\n  turn,\n  avg(input_tokens) AS \"avg input tokens\",\n  (SELECT (value #>> '{}')::int\n    FROM setting\n    WHERE name = 'conversation_max_input_tokens' AND is_active) AS \"limit\"\nFROM\n  numbered\nGROUP BY\n  1\nORDER BY\n  1",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Avg input tokens by turn number (line): use row_number() over (partition by conversation_id order by created_at) as the x axis. A steep curve means context growth is driving cost. Put the 20,000 limit (conversation_max_input_tokens) as a threshold line.",
