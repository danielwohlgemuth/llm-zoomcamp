                                {
                                  "name": "$__interval",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "name": "$__timeGroupAlias(created_at, $__interval)",
                                "type": "string"
                              },
