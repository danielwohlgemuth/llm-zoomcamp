{
    "name": "homework-03-orchestration",
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/homework/03-orchestration",
    "postCreateCommand": "export PATH=\"$HOME/.local/bin:$PATH\" && uv sync",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers-extra/features/uv": {}
    }
}